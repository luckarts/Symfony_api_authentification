# Variables d'environnement — Staging
# Copier vers /home/deploy/authentification-symfony/.env.staging
# et éditer avec les vraies valeurs.

# ── Général ──────────────────────────────────────────────────────────────────
APP_ENV=prod
APP_SECRET=changer-en-staging
IMAGE_TAG=latest-staging

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=app_staging
POSTGRES_USER=app
POSTGRES_PASSWORD=changer-en-staging

# ── Base de données ──────────────────────────────────────────────────────────
# DATABASE_URL est construite dynamiquement dans docker-compose.prod.yml
# à partir de POSTGRES_USER, POSTGRES_PASSWORD et POSTGRES_DB.
# Ne pas la définir ici — un seul source de vérité.

# ── Messenger ────────────────────────────────────────────────────────────────
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# ── JWT / OAuth2 ──────────────────────────────────────────────────────────────
OAUTH_PRIVATE_KEY=/app/config/jwt/private.pem
OAUTH_PUBLIC_KEY=/app/config/jwt/public.pem
OAUTH_PASSPHRASE=changer-en-staging
OAUTH_ENCRYPTION_KEY=changer-en-staging

# ── OAuth2 Default Client ────────────────────────────────────────────────────
OAUTH_DEFAULT_CLIENT_ID=app_staging
OAUTH_DEFAULT_CLIENT_SECRET=changer-en-staging

# ── Traefik / Domaines ────────────────────────────────────────────────────────
APP_HOST=auth-staging.bachelart.fr          # Frontend
API_HOST=api.auth-staging.bachelart.fr       # Backend

# ── Ports hôte ────────────────────────────────────────────────────────────────
APP_PORT=8081                  # Backend (nginx sur 80)
FRONTEND_PORT=8083             # Frontend (Nitro sur 3000)